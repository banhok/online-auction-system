<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="dashboard-container" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.auction.client.controller.SellerPanelController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <padding><Insets bottom="12" left="20" right="20" top="12" /></padding>
            <Button fx:id="btnBack" onAction="#handleBack" styleClass="btn-secondary" text="← Quay lại" />
            <Label styleClass="app-logo" text="🔨 AuctionHub" />
            <Label styleClass="text-muted" text="·" />
            <Label styleClass="section-title" text="📦 Quản lý sản phẩm &amp; Phiên đấu giá" />
            <Region HBox.hgrow="ALWAYS" />
            <StackPane fx:id="avatarSlot" />
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- Tab 1: Tạo sản phẩm — 2 cột, fit window không cần scroll -->
            <Tab text="➕ Tạo sản phẩm">
                <HBox spacing="20">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                    <!-- LEFT: Thông tin chính + Submit -->
                    <VBox spacing="10" styleClass="info-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="form-label" text="Tên sản phẩm" />
                        <TextField fx:id="txtItemName" promptText="VD: iPhone 15 Pro Max" styleClass="form-input" />

                        <Label styleClass="form-label" text="Mô tả" />
                        <TextArea fx:id="txtDescription" prefHeight="69.0" prefRowCount="3" prefWidth="520.0" promptText="Mô tả chi tiết sản phẩm..." styleClass="form-input" />

                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Danh mục" />
                                <ComboBox fx:id="cboCategory" maxWidth="Infinity" styleClass="form-input" />
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Giá khởi điểm (VNĐ)" />
                                <TextField fx:id="txtStartingPrice" promptText="VD: 500000" styleClass="form-input" />
                            </VBox>
                        </HBox>

                        <Separator />
                        <Label styleClass="h3" text="Thông tin chi tiết theo danh mục" />

                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblExtra1" styleClass="form-label" text="Field 1:" />
                                <TextField fx:id="txtExtraField1" styleClass="form-input" />
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblExtra2" styleClass="form-label" text="Field 2:" />
                                <TextField fx:id="txtExtraField2" styleClass="form-input" />
                            </VBox>
                        </HBox>
                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblExtra3" styleClass="form-label" text="Field 3:" />
                                <TextField fx:id="txtExtraField3" styleClass="form-input" />
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblExtra4" styleClass="form-label" text="Field 4:" />
                                <TextField fx:id="txtExtraField4" styleClass="form-input" />
                            </VBox>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleCreateItem" styleClass="btn-primary" text="✅ Tạo sản phẩm" />
                    </VBox>

                    <!-- RIGHT: URL ảnh + Preview to + Tips card -->
                    <VBox maxWidth="420" minWidth="320" prefWidth="360" spacing="10" styleClass="info-card">
                        <Label styleClass="h3" text="Hình ảnh sản phẩm" />
                        <Label styleClass="form-label" text="URL ảnh (tùy chọn)" />
                        <TextField fx:id="txtImageUrl" promptText="https://..." styleClass="form-input" />
                        <StackPane minHeight="340" styleClass="auction-card-image-wrap" VBox.vgrow="ALWAYS">
                            <ImageView fx:id="imgItemPreview" fitHeight="340" fitWidth="360" preserveRatio="true" />
                        </StackPane>
                        <!-- Tips card decoration -->
                        <VBox spacing="4" styleClass="tip-card">
                            <Label styleClass="h3" text="💡 Mẹo đăng tin hấp dẫn" />
                            <Label styleClass="caption" text="✓  Tên rõ ràng, có thương hiệu + model" wrapText="true" />
                            <Label styleClass="caption" text="✓  Mô tả tình trạng cụ thể (xước, hỏng...)" wrapText="true" />
                            <Label styleClass="caption" text="✓  Ảnh chất lượng cao tăng giá thắng 30%" wrapText="true" />
                            <Label styleClass="caption" text="✓  Giá khởi điểm hợp lý → nhiều người tham gia" wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>
            </Tab>

            <!-- Tab 2: Tạo phiên đấu giá — 2 cột, fill khoảng trống bằng hướng dẫn -->
            <Tab text="🔨 Tạo phiên đấu giá">
                <HBox spacing="20">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                    <!-- LEFT: Form -->
                    <VBox spacing="10" styleClass="info-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="h3" text="Thông tin phiên" />

                        <Label styleClass="form-label" text="Sản phẩm" />
                        <ComboBox fx:id="cboAuctionItem" maxWidth="Infinity" promptText="Chọn sản phẩm đã tạo" styleClass="form-input" />
                        <Label styleClass="caption" text="🔄 Danh sách lấy từ tab 'Sản phẩm của tôi'" />

                        <Label styleClass="form-label" text="Giá khởi điểm (VNĐ)" />
                        <TextField fx:id="txtAuctionStartPrice" promptText="VD: 500000" styleClass="form-input" />

                        <HBox spacing="14">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Thời gian bắt đầu" />
                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <DatePicker fx:id="dpStartDate" prefWidth="150" styleClass="form-input" />
                                    <Spinner fx:id="spStartHour" editable="true" prefWidth="70" />
                                    <Label text=":" />
                                    <Spinner fx:id="spStartMinute" editable="true" prefWidth="70" />
                                </HBox>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Thời gian kết thúc" />
                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <DatePicker fx:id="dpEndDate" prefWidth="150" styleClass="form-input" />
                                    <Spinner fx:id="spEndHour" editable="true" prefWidth="70" />
                                    <Label text=":" />
                                    <Spinner fx:id="spEndMinute" editable="true" prefWidth="70" />
                                </HBox>
                            </VBox>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleCreateAuction" styleClass="btn-primary" text="✅ Tạo phiên đấu giá" />
                    </VBox>

                    <!-- RIGHT: Cards giải thích — fill khoảng trống bằng info hữu ích -->
                    <VBox maxWidth="440" minWidth="340" prefWidth="380" spacing="10">
                        <VBox spacing="6" styleClass="tip-card">
                            <Label styleClass="h3" text="📅 Lifecycle phiên đấu giá" />
                            <Label styleClass="caption" text="OPEN  →  Phiên vừa tạo, chờ đến giờ bắt đầu" wrapText="true" />
                            <Label styleClass="caption" text="RUNNING  →  Đang diễn ra, bidder đặt giá" wrapText="true" />
                            <Label styleClass="caption" text="FINISHED  →  Hết giờ, winner xác định" wrapText="true" />
                            <Label styleClass="caption" text="PAID  →  Winner đã thanh toán xong" wrapText="true" />
                            <Label styleClass="caption" text="CANCELED  →  Bạn huỷ → hoàn cọc bidder" wrapText="true" />
                        </VBox>

                        <VBox spacing="6" styleClass="tip-card">
                            <Label styleClass="h3" text="⚡ Anti-snipe" />
                            <Label styleClass="caption" text="Nếu có bid trong 60 giây cuối, phiên tự động gia hạn thêm 60 giây — ngăn bidder bid phút chót giành lợi thế." wrapText="true" />
                        </VBox>

                        <VBox spacing="6" styleClass="tip-card">
                            <Label styleClass="h3" text="💵 Tiền cọc" />
                            <Label styleClass="caption" text="Bidder phải đặt cọc = 10% giá khởi điểm để tham gia. Thắng → trừ vào tổng thanh toán. Thua → hoàn 100%." wrapText="true" />
                        </VBox>
                    </VBox>
                </HBox>
            </Tab>

            <!-- Tab 3: Phiên đấu giá của tôi -->
            <Tab text="📋 Phiên của tôi">
                <VBox spacing="10">
                    <padding><Insets bottom="10" left="10" right="10" top="20" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="hint-label" text="💡 Chỉ huỷ được phiên ở trạng thái OPEN hoặc RUNNING — toàn bộ cọc sẽ được hoàn cho bidder." wrapText="true" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleRefreshAuctions" styleClass="btn-secondary" text="🔄 Làm mới" />
                    </HBox>
                    <TableView fx:id="tableMyAuctions" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colAucItem" prefWidth="180" text="Sản phẩm" />
                            <TableColumn fx:id="colAucPrice" prefWidth="130" text="Giá hiện tại" />
                            <TableColumn fx:id="colAucBids" prefWidth="80" text="Lượt bid" />
                            <TableColumn fx:id="colAucStatus" prefWidth="110" text="Trạng thái" />
                            <TableColumn fx:id="colAucStart" prefWidth="160" text="Bắt đầu" />
                            <TableColumn fx:id="colAucEnd" prefWidth="160" text="Kết thúc" />
                            <TableColumn fx:id="colAucCancel" prefWidth="100" text="Thao tác" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" styleClass="empty-state">
                                <Label styleClass="empty-state-icon" text="🔨" />
                                <Label styleClass="empty-state-title" text="Bạn chưa tạo phiên đấu giá nào" />
                                <Label styleClass="empty-state-subtitle" text="Vào tab 'Tạo phiên đấu giá' để bắt đầu" />
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab 4: Sản phẩm của tôi -->
            <Tab text="📦 Sản phẩm của tôi">
                <VBox spacing="10">
                    <padding><Insets bottom="10" left="10" right="10" top="20" /></padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="hint-label" text="📦 Danh sách sản phẩm bạn đã tạo. Click 'Tạo phiên đấu giá' để bắt đầu phiên." wrapText="true" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleRefreshItems" styleClass="btn-secondary" text="🔄 Làm mới" />
                    </HBox>
                    <TableView fx:id="tableMyItems" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colItemName" prefWidth="240" text="Tên" />
                            <TableColumn fx:id="colItemCategory" prefWidth="120" text="Danh mục" />
                            <TableColumn fx:id="colItemPrice" prefWidth="140" text="Giá khởi điểm" />
                            <TableColumn fx:id="colItemStatus" prefWidth="160" text="Trạng thái" />
                            <TableColumn fx:id="colItemAction" prefWidth="100" text="Thao tác" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" styleClass="empty-state">
                                <Label styleClass="empty-state-icon" text="🛍" />
                                <Label styleClass="empty-state-title" text="Bạn chưa tạo sản phẩm nào" />
                                <Label styleClass="empty-state-subtitle" text="Vào tab 'Tạo sản phẩm' để thêm sản phẩm đầu tiên" />
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
