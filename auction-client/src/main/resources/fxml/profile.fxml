<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="dashboard-container" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.auction.client.controller.ProfileController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <padding><Insets bottom="12" left="20" right="20" top="12" /></padding>
            <Button fx:id="btnBack" onAction="#handleBack" styleClass="btn-secondary" text="← Quay lại" />
            <Label styleClass="app-logo" text="🔨 AuctionHub" />
            <Region HBox.hgrow="ALWAYS" />
            <StackPane fx:id="avatarSlot" />
            <Label styleClass="section-title" text="👤 Tài khoản của tôi" />
        </HBox>
    </top>

    <center>
        <HBox spacing="20">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

            <!-- LEFT COLUMN: Info + Edit + Change password (fit window, KHÔNG cần scroll) -->
            <VBox maxWidth="540" minWidth="460" prefWidth="500" spacing="12">

                <!-- Info -->
                <VBox spacing="6" styleClass="info-card">
                    <Label styleClass="h3" text="Thông tin tài khoản" />
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="100" styleClass="caption" text="Username:" />
                        <Label fx:id="lblUsername" styleClass="balance-label" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="100" styleClass="caption" text="Vai trò:" />
                        <Label fx:id="lblRole" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label prefWidth="100" styleClass="caption" text="Số dư:" />
                        <Label fx:id="lblBalance" styleClass="balance-label" />
                    </HBox>
                </VBox>

                <!-- Edit profile -->
                <VBox spacing="6" styleClass="info-card">
                    <Label styleClass="h3" text="Chỉnh sửa thông tin" />
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Họ tên" />
                            <TextField fx:id="txtFullName" styleClass="form-input" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Email" />
                            <TextField fx:id="txtEmail" styleClass="form-input" />
                        </VBox>
                    </HBox>
                    <Button maxWidth="Infinity" onAction="#handleUpdateProfile" styleClass="btn-primary" text="💾 Lưu thay đổi" />
                </VBox>

                <!-- Change password -->
                <VBox spacing="6" styleClass="info-card">
                    <Label styleClass="h3" text="Đổi mật khẩu" />
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Mật khẩu cũ" />
                            <PasswordField fx:id="txtOldPassword" styleClass="form-input" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Mật khẩu mới" />
                            <PasswordField fx:id="txtNewPassword" styleClass="form-input" />
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-label" text="Xác nhận" />
                            <PasswordField fx:id="txtConfirmNewPassword" styleClass="form-input" />
                        </VBox>
                    </HBox>
                    <Button maxWidth="Infinity" onAction="#handleChangePassword" styleClass="btn-success" text="🔑 Đổi mật khẩu" />
                </VBox>

                <!-- Stats card (decoration + tận dụng wallet data có sẵn) -->
                <VBox prefHeight="99.0" prefWidth="500.0" spacing="10" styleClass="info-card" VBox.vgrow="ALWAYS">
                    <Label styleClass="h3" text="📊 Thống kê hoạt động" />
                    <HBox spacing="10">
                        <VBox alignment="CENTER" spacing="2" styleClass="stat-mini" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-mini-icon" text="💰" />
                            <Label fx:id="lblStatDeposit" styleClass="stat-mini-value" text="0 VNĐ" />
                            <Label styleClass="stat-mini-caption" text="Tổng nạp" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="stat-mini" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-mini-icon" text="🏆" />
                            <Label fx:id="lblStatWins" styleClass="stat-mini-value" text="0 VNĐ" />
                            <Label styleClass="stat-mini-caption" text="Thắng" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="stat-mini" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-mini-icon" text="🔒" />
                            <Label fx:id="lblStatHold" styleClass="stat-mini-value" text="0 VNĐ" />
                            <Label styleClass="stat-mini-caption" text="Cọc giữ" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" styleClass="stat-mini" HBox.hgrow="ALWAYS">
                            <Label styleClass="stat-mini-icon" text="📋" />
                            <Label fx:id="lblStatTxCount" styleClass="stat-mini-value" text="0" />
                            <Label styleClass="stat-mini-caption" text="Giao dịch" />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- RIGHT COLUMN: Wallet history (stretch full height + width) -->
            <VBox spacing="8" styleClass="info-card" HBox.hgrow="ALWAYS">
                <Label styleClass="h3" text="📜 Lịch sử giao dịch ví" />
                <Label styleClass="caption" text="Toàn bộ giao dịch ví của bạn — nạp, rút, cọc, hoàn tiền, thanh toán." wrapText="true" />
                <TableView fx:id="tableWalletHistory" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colTxType" prefWidth="120" text="Loại" />
                        <TableColumn fx:id="colTxAmount" prefWidth="130" text="Số tiền" />
                        <TableColumn fx:id="colTxDesc" prefWidth="240" text="Mô tả" />
                        <TableColumn fx:id="colTxTime" prefWidth="170" text="Thời gian" />
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="8" styleClass="empty-state">
                            <Label styleClass="empty-state-icon" text="💳" />
                            <Label styleClass="empty-state-title" text="Chưa có giao dịch nào" />
                            <Label styleClass="empty-state-subtitle" text="Lịch sử nạp/rút/đấu giá sẽ hiển thị ở đây" />
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
