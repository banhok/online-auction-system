<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="dashboard-container" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.auction.client.controller.AuctionDetailController">

    <!-- TOP -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">
            <padding><Insets bottom="12" left="20" right="20" top="12" /></padding>
            <Button fx:id="btnBack" onAction="#handleBack" styleClass="btn-secondary" text="← Quay lại" />
            <Label styleClass="app-logo" text="🔨 AuctionHub" />
            <Label styleClass="text-muted" text="·" />
            <Label fx:id="lblAuctionId" styleClass="section-title" text="Phiên #0" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblStatus" styleClass="status-badge" text="RUNNING" />
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <HBox spacing="16">
            <padding><Insets bottom="16" left="20" right="20" top="16" /></padding>

            <!-- LEFT: Thông tin compact, KHÔNG cần scroll, fit window -->
            <VBox maxWidth="560" minWidth="500" prefWidth="520" spacing="12">
                <!-- Card 1: Image + Item info + Status -->
                <VBox spacing="8" styleClass="info-card">
                    <StackPane maxHeight="220" minHeight="220" prefHeight="220" styleClass="auction-card-image-wrap">
                        <ImageView fx:id="imgItem" fitHeight="220" fitWidth="500" preserveRatio="true" />
                    </StackPane>
                    <Label fx:id="lblItemName" styleClass="h2" text="Item #0" />
                    <Label fx:id="lblItemDetails" styleClass="caption" text="" wrapText="true" />
                    <Label fx:id="lblExtendedBadge" managed="false" styleClass="badge-warning" text="🕒 Đã gia hạn (anti-snipe)" visible="false" />
                </VBox>

                <!-- Card 2: Price + Countdown compact horizontal -->
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="info-card">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label styleClass="caption" text="💰 Giá hiện tại" />
                        <Label fx:id="lblCurrentPrice" styleClass="current-price" text="0 VNĐ" />
                        <HBox spacing="10">
                            <Label fx:id="lblBidCount" styleClass="caption" text="0 lượt" />
                            <Label fx:id="lblParticipantCount" styleClass="caption" text="👥 0" />
                            <Label fx:id="lblStartingPrice" styleClass="caption" text="KĐ: 0" />
                        </HBox>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" minWidth="180" spacing="2">
                        <Label styleClass="caption" text="⏱ Còn lại" />
                        <Label fx:id="lblCountdown" styleClass="countdown-normal" text="00:00:00" />
                        <Label fx:id="lblStartEndTime" styleClass="caption" text="" />
                    </VBox>
                </HBox>

                <!-- Card 3: Đặt cọc + Đặt giá — stretch fill height match cột phải -->
                <VBox prefWidth="520.0" spacing="10" styleClass="info-card" VBox.vgrow="ALWAYS">
                    <Button fx:id="btnJoinAuction" maxWidth="Infinity" onAction="#handleJoinAuction" styleClass="btn-success" text="🎫 Đặt cọc tham gia" />
                    <Separator />
                    <Label styleClass="form-label" text="Nhập giá đặt" />
                    <HBox spacing="10">
                        <TextField fx:id="txtBidAmount" promptText="Nhập số tiền..." styleClass="form-input" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPlaceBid" onAction="#handlePlaceBid" styleClass="btn-primary" text="🔨 Đặt giá" />
                    </HBox>
                    <HBox spacing="8" styleClass="quick-bid-row">
                        <Label styleClass="form-label" text="Bid nhanh:" />
                        <Button onAction="#handleQuickBid10" styleClass="btn-quick" text="+10%" />
                        <Button onAction="#handleQuickBid20" styleClass="btn-quick" text="+20%" />
                        <Button onAction="#handleQuickBid50" styleClass="btn-quick" text="+50%" />
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <Button fx:id="btnPay" managed="false" maxWidth="Infinity" onAction="#handlePay" styleClass="btn-primary" text="💳 Thanh toán" visible="false" />
                </VBox>
            </VBox>

            <!-- RIGHT: Chart + Bid History -->
            <VBox spacing="15" HBox.hgrow="ALWAYS">
                <!-- Biểu đồ giá realtime -->
                <VBox styleClass="info-card" VBox.vgrow="SOMETIMES">
                    <Label styleClass="form-label" text="📈 Biểu đồ giá realtime" />
                    <LineChart fx:id="chartPrice" animated="false" prefHeight="250">
                        <xAxis><NumberAxis autoRanging="true" label="Lượt bid" fx:id="xAxis" /></xAxis>
                        <yAxis><NumberAxis fx:id="yAxis" autoRanging="true" label="Giá (VNĐ)" /></yAxis>
                    </LineChart>
                </VBox>

                <!-- Lịch sử bid -->
                <VBox spacing="6" styleClass="info-card" VBox.vgrow="ALWAYS">
                    <Label styleClass="h3" text="📜 Lịch sử đấu giá" />
                    <TableView fx:id="tableBidHistory" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colBidder" prefWidth="120" text="Người đặt" />
                            <TableColumn fx:id="colAmount" prefWidth="130" text="Giá đặt" />
                            <TableColumn fx:id="colTime" prefWidth="180" text="Thời gian" />
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" styleClass="empty-state">
                                <Label styleClass="empty-state-icon" text="🔨" />
                                <Label styleClass="empty-state-title" text="Chưa có lượt đấu giá nào" />
                                <Label styleClass="empty-state-subtitle" text="Người đặt giá đầu tiên sẽ xuất hiện ở đây" />
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
